  "robot_info_version": "0.2",

  "name": "Omnemo",
  "tagline": "One shared memory for every AI agent harness on an Omarchy computer. Save in one, recall in any.",
  "summary": "Omnemo is a small local memory server for the AI coding agents on an Omarchy Linux computer. It stores memories in one SQLite file, embeds them with a local model, and serves four MCP tools (save, recall, search, forget) over stdio. `omnemo setup` registers that server with Claude Code, Codex, OpenCode, Crush and Gemini CLI and reads each registration back, and installs a memory skill that tells the agents when to save and when to recall. So a fact Claude Code saved is recalled by Codex the next day.",
  "version": "0.2.1.dev4",
  "version_note": "Install from GitHub main (INSTALL.md); main is 0.2.1.dev4. The last tagged release is v0.2.0 (2026-09-07). The PyPI package `omnemo` is 0.1.1 and out of date: do not `pip install omnemo`.",
  "license": "MIT",
  "homepage": "https://projectsparks.ai/omnemo",
  "source": "https://github.com/GuyMannDude/omnemo",
  "contact": "https://github.com/GuyMannDude/omnemo/issues",
  "maintainer": "Project Sparks",

  "capabilities": [
    "One memory store per computer user: ~/.local/share/omnemo/store.db (SQLite). Every harness that runs `omnemo serve` reads and writes the same file.",
    "Four MCP tools over stdio: save, recall, search, forget.",
    "Recall by meaning: local embeddings (default fastembed:BAAI/bge-small-en-v1.5), ranked by a composite score of similarity, recency, category importance and how often a memory was recalled. Candidates below min_similarity (0.35) are dropped.",
    "Memories decay by kind: five categories (fact, decision, preference, incident, transient), each with its own importance and half-life multiplier on a 30-day base half-life. All tunable in config.toml.",
    "Truth changes: save reports near-duplicates (cosine >= 0.90, at most 5) so the caller can pass their ids as `supersedes`; a superseded memory is never recalled, search still lists it with superseded_by, and forgetting the new memory brings the old one back.",
    "Durable on return: a save is on disk when the call returns (examples/crash_demo.py kills the server right after a save and recalls it from a fresh process).",
    "`omnemo setup` (idempotent): installs the memory skill and links it into ~/.agents/skills, ~/.claude/skills, ~/.codex/skills and ~/.pi/agent/skills; copies the bar widget files to ~/.config/omarchy/plugins/omnemo.memory/; writes and enables the omnemo-warm.service user unit (loads the model at login); registers the MCP server with each installed harness and reads every registration back. A row it cannot verify prints FAIL, never assumed.",
    "Optional bar widget (off by default): `omnemo setup --bar` or `omnemo bar on` adds a memory count to the right of the Omarchy bar; `omnemo bar off` removes it.",
    "Crash memory is skill guidance, not a code hook: when Omarchy hands an agent a crash (omarchy-agent-crash), the skill tells it to recall the crashing program's name first and to save the fix after.",
    "Works offline after the first run (the first run downloads the embedding model once)."
  ],

  "exposes": {
    "mcp_tools": [
      {"name": "save", "purpose": "Save one memory. Args: text, category (optional; default 'fact'), supersedes (optional list of ids this replaces). Returns id, category, near_duplicates."},
      {"name": "recall", "purpose": "Recall memories by meaning. Args: query, limit (optional; default 5). Returns id, text, category, similarity, score."},
      {"name": "search", "purpose": "Literal substring search, case-insensitive. Args: query, limit (optional; default 20). Returns id, text, category, superseded_by."},
      {"name": "forget", "purpose": "Permanently delete a memory by id (removed from the store, not hidden). Returns {forgotten: true|false}."}
    ],
    "cli": [
      {"command": "omnemo serve", "purpose": "Run the MCP server on stdio (this is what harnesses start)."},
      {"command": "omnemo save TEXT [--category/-c CAT] [--supersedes ID ...]", "purpose": "Save one memory from the shell."},
      {"command": "omnemo recall QUERY [--limit/-n N]", "purpose": "Recall by meaning."},
      {"command": "omnemo search QUERY [--limit/-n N]", "purpose": "Substring search."},
      {"command": "omnemo forget ID", "purpose": "Permanently delete one memory."},
      {"command": "omnemo stats [--json]", "purpose": "Memory count, learned today, last recall."},
      {"command": "omnemo warm", "purpose": "Load the embedding model (what the warm-up unit runs at login)."},
      {"command": "omnemo setup [--bar]", "purpose": "Install skill, bar widget files, warm-up unit, and register with every installed harness. --bar also puts the widget on the bar."},
      {"command": "omnemo bar on|off", "purpose": "Put the memory widget on the Omarchy bar, or take it off."},
      {"command": "omnemo connect", "purpose": "Register the MCP server with every installed harness (setup does this too)."},
      {"command": "omnemo disconnect [--all-pieces]", "purpose": "Unregister from every harness; --all-pieces also removes the skill links, bar widget files and warm-up unit. Never touches the memory store."},
      {"command": "omnemo --version", "purpose": "Print the installed version."}
    ]
  },

  "configuration": {
    "file": "~/.config/omnemo/config.toml ($XDG_CONFIG_HOME/omnemo/config.toml). Optional: a missing file or key uses the defaults below. A bad value stops with an error that names the key.",
    "environment": [
      {"name": "XDG_CONFIG_HOME", "default": "~/.config", "changes": "Where config.toml is read from (<XDG_CONFIG_HOME>/omnemo/config.toml)."},
      {"name": "XDG_DATA_HOME", "default": "~/.local/share", "changes": "Where the memory store lives (<XDG_DATA_HOME>/omnemo/store.db)."}
    ],
    "keys": [
      {"key": "embedder", "default": "fastembed:BAAI/bge-small-en-v1.5", "changes": "Embedding model. Only the fastembed:<model> form is supported. A store is locked to the embedder it was created with: Omnemo refuses to open an existing store under a different one, so changing this needs a fresh store."},
      {"key": "min_similarity", "default": 0.35, "changes": "Recall drops candidates below this cosine similarity."},
      {"key": "weight_similarity", "default": 1.0, "changes": "Weight of similarity in the recall score."},
      {"key": "weight_recency", "default": 0.25, "changes": "Weight of recency (0.5 ** (age_days / (base_half_life_days * category half_life_multiplier)))."},
      {"key": "weight_importance", "default": 0.15, "changes": "Weight of the category's importance."},
      {"key": "weight_recall_count", "default": 0.10, "changes": "Weight of how often the memory was recalled (capped at recall_count_cap)."},
      {"key": "base_half_life_days", "default": 30.0, "changes": "Base recency half-life in days (must be > 0)."},
      {"key": "recall_count_cap", "default": 10, "changes": "Recall count at which the frequency bonus stops growing (>= 1)."},
      {"key": "default_category", "default": "fact", "changes": "Category used when a save names none. Must be a configured category."},
      {"key": "recall_limit", "default": 5, "changes": "Results recall returns when no limit is given."},
      {"key": "search_limit", "default": 20, "changes": "Results search returns when no limit is given."},
      {"key": "near_duplicate_similarity", "default": 0.90, "changes": "Cosine at/above which save reports an older memory as a near-duplicate (0..1)."},
      {"key": "near_duplicate_limit", "default": 5, "changes": "Most near-duplicates save reports. 0 turns the check off."},
      {"key": "fallback_importance", "default": 0.5, "changes": "Importance for memories whose category was removed from the config, and the default for a new category that omits importance."},
      {"key": "fallback_half_life_multiplier", "default": 1.0, "changes": "Half-life multiplier for the same cases."},
      {"key": "[categories.<name>] importance / half_life_multiplier", "default": "fact 0.6/4.0 · decision 1.0/6.0 · preference 0.8/8.0 · incident 0.9/2.0 · transient 0.2/0.25", "changes": "Tune a shipped category or add a new one (a new name becomes a valid category for save)."}
    ],
    "example": "# ~/.config/omnemo/config.toml\nrecall_limit = 8\nbase_half_life_days = 60\n\n[categories.recipe]\nimportance = 0.7\nhalf_life_multiplier = 10"
  },

